import { Button, CheckBox, ComboBox, LineEdit, ListView, ScrollView, SpinBox } from "std-widgets.slint";

export struct CustomCell {
    field-id: string,
    value: string,
    editable: bool,
    boolean: bool,
    checkbox: bool,
    checked: bool,
}

export struct CheckboxOption {
    label: string,
    checked: bool,
}

export struct IssueRow {
    key: string,
    summary: string,
    status: string,
    status-done: bool,
    issue-type: string,
    assignee: string,
    due: string,
    estimate: string,
    spent: string,
    remaining: string,
    parent: string,
    depth: int,
    has-children: bool,
    expanded: bool,
    custom-cells: [CustomCell],
}

export struct CustomColumn {
    id: string,
    name: string,
    editable: bool,
    field-type: string,
}

export struct TreeNode {
    key: string,
    label: string,
    depth: int,
    has-children: bool,
    expanded: bool,
    favorite: bool,
}

export struct CalendarDay {
    label: string,
    date: string,
    row: int,
    column: int,
    current-month: bool,
}

component SectionTitle inherits Text {
    font-size: 13px;
    font-weight: 700;
    color: #24324a;
    vertical-alignment: center;
}

component PaneDivider inherits Rectangle {
    in-out property <length> pane-size;
    in property <length> minimum: 180px;
    in property <length> maximum: 520px;
    in property <float> direction: 1;
    width: 7px;
    background: drag.has-hover || drag.pressed ? #c7d2fe : #e2e8f0;
    drag := TouchArea {
        property <length> pressed-size;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                self.pressed-size = root.pane-size;
            }
        }
        moved => {
            if (self.pressed) {
                root.pane-size = (self.pressed-size + (self.mouse-x - self.pressed-x) * root.direction).clamp(root.minimum, root.maximum);
            }
        }
    }
}

component ColumnDivider inherits Rectangle {
    in-out property <length> column-width;
    in property <length> minimum: 48px;
    in property <length> maximum: 520px;
    width: 6px;
    background: drag.has-hover || drag.pressed ? #818cf8 : transparent;
    drag := TouchArea {
        property <length> pressed-width;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                self.pressed-width = root.column-width;
            }
        }
        moved => {
            if (self.pressed) {
                root.column-width = (self.pressed-width + self.mouse-x - self.pressed-x).clamp(root.minimum, root.maximum);
            }
        }
    }
}

component TreeButton inherits Rectangle {
    in property <string> label;
    in property <string> key;
    in property <int> depth: 0;
    in property <bool> has-children;
    in property <bool> expanded;
    in property <bool> favorite;
    callback chosen(string);
    callback toggled(string);
    callback favorite-toggled(string);
    height: 34px;
    border-radius: 5px;
    background: touch.has-hover ? #e9efff : transparent;
    expand-box := Rectangle {
        x: 5px + root.depth * 15px; y: 8px; width: 18px; height: 18px;
        visible: root.has-children;
        border-color: #cbd5e1; border-width: 1px; border-radius: 3px;
        background: expand-touch.has-hover ? #e2e8f0 : white;
        Text { text: root.expanded ? "-" : "+"; horizontal-alignment: center; vertical-alignment: center; font-size: 13px; color: #334155; }
        expand-touch := TouchArea { clicked => { root.toggled(root.key); } }
    }
    Text { x: 28px + root.depth * 15px; width: parent.width - self.x - 27px; text: root.label; color: #334155; font-size: 12px; vertical-alignment: center; overflow: elide; }
    pin := Rectangle { x: parent.width - 24px; y: 7px; width: 20px; height: 20px; visible: root.key != ""; border-radius: 4px; background: pin-touch.has-hover ? #dbeafe : transparent;
        Text { text: root.favorite ? "*" : "+"; color: root.favorite ? #d97706 : #64748b; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        pin-touch := TouchArea { clicked => { root.favorite-toggled(root.key); } }
    }
    touch := TouchArea { x: 25px + root.depth * 15px; width: parent.width - self.x - 27px; clicked => { root.chosen(root.key); } }
}

export component AppWindow inherits Window {
    title: "Jira Lens";
    preferred-width: 1280px;
    preferred-height: 780px;
    min-width: 900px;
    min-height: 580px;
    background: #f6f8fb;

    in property <[IssueRow]> issues;
    in property <[TreeNode]> tree-nodes;
    in property <[CustomColumn]> custom-columns;
    in property <[string]> available-custom-fields;
    in-out property <int> selected-custom-field-index: 0;
    in property <[string]> issue-types;
    in-out property <int> selected-type-index: 0;
    in property <[CalendarDay]> calendar-days;
    in property <[string]> status-filters;
    in-out property <int> selected-status-index: 0;
    in-out property <string> active-status-filter: "すべての状態";
    in-out property <string> selected-key: "APP-102";
    in-out property <string> selected-summary: "課題一覧テーブル";
    in-out property <string> selected-description: "Excelのように見通しのよい一覧を作る";
    in-out property <string> selected-comments: "列の表示切替を追加";
    in-out property <string> selected-issue-type: "タスク";
    in-out property <string> selected-status: "進行中";
    in-out property <string> selected-assignee: "";
    in-out property <string> selected-due: "2026-08-28";
    in-out property <string> selected-estimate: "12h";
    in-out property <string> selected-spent: "4h";
    in-out property <string> selected-remaining: "8h";
    in-out property <string> active-parent: "すべての課題";
    in-out property <int> result-count: 0;
    in-out property <bool> show-assignee: true;
    in-out property <bool> show-due: true;
    in-out property <bool> show-estimate: true;
    in-out property <bool> show-spent: true;
    in-out property <bool> show-remaining: true;
    in-out property <bool> show-calendar: false;
    in-out property <string> calendar-label: "";
    in-out property <string> worklog-date: "";
    in-out property <string> worklog-time: "09:00";
    in-out property <int> worklog-minutes: 60;
    in-out property <string> worklog-remaining: "0h";
    in-out property <bool> worklog-auto-adjust: true;
    in-out property <string> action-status: "";
    in-out property <bool> action-busy: false;
    in-out property <bool> connection-busy: false;
    in-out property <bool> has-synced-data: false;
    in-out property <string> connection-status: "未接続";
    in-out property <length> left-pane-width: 260px;
    in-out property <length> right-pane-width: 330px;
    in-out property <bool> show-left-pane: true;
    in-out property <bool> show-right-pane: true;
    in-out property <bool> edit-mode: false;
    in-out property <bool> confirm-discard: false;
    in-out property <bool> checkbox-editor-open: false;
    in-out property <string> checkbox-editor-key: "";
    in-out property <string> checkbox-editor-field-id: "";
    in-out property <string> checkbox-editor-title: "";
    in-out property <[CheckboxOption]> checkbox-options;
    in-out property <length> issue-type-column-width: 96px;
    in-out property <length> key-column-width: 112px;
    in-out property <length> summary-column-width: 300px;
    in-out property <length> status-column-width: 92px;
    in-out property <length> assignee-column-width: 86px;
    in-out property <length> due-column-width: 92px;
    in-out property <length> estimate-column-width: 70px;
    in-out property <length> spent-column-width: 70px;
    in-out property <length> remaining-column-width: 70px;
    in-out property <length> custom-column-width: 120px;
    in property <length> table-content-width: 20px
        + root.issue-type-column-width + 6px
        + root.key-column-width + 6px
        + root.summary-column-width + 6px
        + root.status-column-width + 6px
        + (root.show-assignee ? root.assignee-column-width + 6px : 0px)
        + (root.show-due ? root.due-column-width + 6px : 0px)
        + (root.show-estimate ? root.estimate-column-width + 6px : 0px)
        + (root.show-spent ? root.spent-column-width + 6px : 0px)
        + (root.show-remaining ? root.remaining-column-width + 6px : 0px)
        + root.custom-columns.length * (root.custom-column-width + 6px);
    callback select-issue(string);
    callback search(string);
    callback filter-parent(string);
    callback filter-type(string);
    callback toggle-tree(string);
    callback expand-all-tree();
    callback collapse-all-tree();
    callback filter-status(string);
    callback toggle-favorite(string);
    callback connect-oauth();
    callback columns-changed(bool, bool, bool, bool, bool);
    callback add-custom-column(string);
    callback remove-custom-column(string);
    callback begin-table-edit();
    callback edit-table-cell(string, string, string);
    callback save-table-edit();
    callback open-checkbox-editor(string, string);
    callback toggle-checkbox-option(int, bool);
    callback apply-checkbox-options();
    callback discard-table-edit();
    callback log-work(string, string, string, int, string, bool);
    callback calendar-previous();
    callback calendar-next();
    callback choose-date(string);
    callback open-issue-in-jira();

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 52px;
            background: #172554;
            HorizontalLayout {
                padding-left: 18px; padding-right: 18px; spacing: 14px;
                Text { text: "Jira Lens"; color: white; font-size: 19px; font-weight: 700; vertical-alignment: center; }
                Button { text: root.show-left-pane ? "ツリーを閉じる" : "ツリーを開く"; clicked => { root.show-left-pane = !root.show-left-pane; } }
                Button { text: root.show-right-pane ? "詳細を閉じる" : "詳細を開く"; clicked => { root.show-right-pane = !root.show-right-pane; } }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Text { text: root.connection-status; color: #c7d2fe; font-size: 12px; vertical-alignment: center; }
                Button { enabled: !root.connection-busy; text: root.connection-busy ? "同期中..." : root.has-synced-data ? "再同期" : "Jiraに接続"; clicked => { root.connect-oauth(); } }
            }
        }

        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                visible: root.show-left-pane; width: root.show-left-pane ? root.left-pane-width : 0px; background: #ffffff;
                VerticalLayout {
                    padding: 12px; spacing: 7px;
                    HorizontalLayout { height: 28px; spacing: 5px;
                        SectionTitle { text: "課題ツリー"; horizontal-stretch: 1; }
                        Button { text: "全部開く"; clicked => { root.expand-all-tree(); } }
                        Button { text: "全部閉じる"; clicked => { root.collapse-all-tree(); } }
                    }
                    LineEdit { placeholder-text: "タイトル・本文・コメントを検索"; accepted => { root.search(self.text); } }
                    ComboBox { model: root.issue-types; current-index <=> root.selected-type-index; selected(value) => { root.filter-type(value); } }
                    tree := ListView {
                        vertical-stretch: 1;
                        for node in root.tree-nodes : TreeButton {
                            width: tree.viewport-width;
                            label: node.label;
                            key: node.key;
                            depth: node.depth;
                            has-children: node.has-children;
                            expanded: node.expanded;
                            favorite: node.favorite;
                            chosen(key) => { root.filter-parent(key); }
                            toggled(key) => { root.toggle-tree(key); }
                            favorite-toggled(key) => { root.toggle-favorite(key); }
                        }
                    }
                    Text { text: "同期データは端末内にキャッシュ"; color: #94a3b8; font-size: 10px; }
                }
            }

            PaneDivider { visible: root.show-left-pane; width: root.show-left-pane ? 7px : 0px; pane-size <=> root.left-pane-width; minimum: 180px; maximum: 480px; }

            Rectangle {
                horizontal-stretch: 1; min-width: 0px; preferred-width: 360px; background: #f8fafc;
                VerticalLayout {
                    padding: 14px; spacing: 10px;
                    HorizontalLayout {
                        height: 34px; spacing: 8px;
                        SectionTitle { text: root.active-parent + " / " + root.result-count + "件"; horizontal-stretch: 1; }
                        table-search := LineEdit { enabled: !root.edit-mode; width: 220px; placeholder-text: "一覧を検索"; accepted => { root.search(self.text); } }
                        Button { enabled: !root.edit-mode; text: "検索"; clicked => { root.search(table-search.text); } }
                        Button { visible: !root.edit-mode; text: "編集"; clicked => { root.begin-table-edit(); root.edit-mode = true; } }
                        Button { visible: root.edit-mode; text: "保存"; primary: true; clicked => { root.save-table-edit(); } }
                        Button { visible: root.edit-mode; text: "キャンセル"; clicked => { root.confirm-discard = true; } }
                        ComboBox { enabled: !root.edit-mode; width: 130px; model: root.status-filters; current-index <=> root.selected-status-index; selected(value) => { root.active-status-filter = value; root.filter-status(value); } }
                    }
                    Rectangle {
                        height: 40px; background: #eef2ff; border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; spacing: 12px;
                            Text { text: "表示列"; font-size: 11px; vertical-alignment: center; color: #475569; }
                            CheckBox { text: "担当者"; checked <=> root.show-assignee; toggled => { root.columns-changed(root.show-assignee, root.show-due, root.show-estimate, root.show-spent, root.show-remaining); } }
                            CheckBox { text: "期限"; checked <=> root.show-due; toggled => { root.columns-changed(root.show-assignee, root.show-due, root.show-estimate, root.show-spent, root.show-remaining); } }
                            CheckBox { text: "見積"; checked <=> root.show-estimate; toggled => { root.columns-changed(root.show-assignee, root.show-due, root.show-estimate, root.show-spent, root.show-remaining); } }
                            CheckBox { text: "消費"; checked <=> root.show-spent; toggled => { root.columns-changed(root.show-assignee, root.show-due, root.show-estimate, root.show-spent, root.show-remaining); } }
                            CheckBox { text: "残余"; checked <=> root.show-remaining; toggled => { root.columns-changed(root.show-assignee, root.show-due, root.show-estimate, root.show-spent, root.show-remaining); } }
                            ComboBox { width: 150px; model: root.available-custom-fields; current-index <=> root.selected-custom-field-index; selected(value) => { root.add-custom-column(value); } }
                            for column in root.custom-columns : Button { text: column.name + " x"; clicked => { root.remove-custom-column(column.id); } }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                    }
                    Rectangle {
                        min-width: 0px; preferred-width: 0px; clip: true; background: white; border-color: #e2e8f0; border-width: 1px; border-radius: 7px;
                        VerticalLayout {
                            spacing: 0px;
                            Rectangle {
                                height: 36px; min-width: 0px; clip: true; background: #f1f5f9;
                                HorizontalLayout { x: list.viewport-x; width: root.table-content-width; min-width: 0px; preferred-width: 0px; padding-left: 10px; padding-right: 10px; spacing: 0px;
                                    Text { width: root.issue-type-column-width; text: "課題タイプ"; font-weight: 700; font-size: 11px; vertical-alignment: center; horizontal-alignment: left; }
                                    ColumnDivider { column-width <=> root.issue-type-column-width; }
                                    Text { width: root.key-column-width; text: "キー"; font-weight: 700; font-size: 11px; vertical-alignment: center; horizontal-alignment: left; }
                                    ColumnDivider { column-width <=> root.key-column-width; minimum: 80px; }
                                    Text { width: root.summary-column-width; text: "タイトル"; font-weight: 700; font-size: 11px; vertical-alignment: center; horizontal-alignment: left; }
                                    ColumnDivider { column-width <=> root.summary-column-width; minimum: 120px; }
                                    Text { width: root.status-column-width; text: "状態"; font-weight: 700; font-size: 11px; vertical-alignment: center; horizontal-alignment: left; }
                                    ColumnDivider { column-width <=> root.status-column-width; }
                                    Text { visible: root.show-assignee; width: root.assignee-column-width; text: "担当者"; font-weight: 700; font-size: 11px; vertical-alignment: center; horizontal-alignment: left; }
                                    ColumnDivider { visible: root.show-assignee; column-width <=> root.assignee-column-width; }
                                    Text { visible: root.show-due; width: root.due-column-width; text: "期限"; font-weight: 700; font-size: 11px; vertical-alignment: center; horizontal-alignment: left; }
                                    ColumnDivider { visible: root.show-due; column-width <=> root.due-column-width; }
                                    Text { visible: root.show-estimate; width: root.estimate-column-width; text: "見積"; font-weight: 700; font-size: 11px; vertical-alignment: center; horizontal-alignment: left; }
                                    ColumnDivider { visible: root.show-estimate; column-width <=> root.estimate-column-width; }
                                    Text { visible: root.show-spent; width: root.spent-column-width; text: "消費"; font-weight: 700; font-size: 11px; vertical-alignment: center; horizontal-alignment: left; }
                                    ColumnDivider { visible: root.show-spent; column-width <=> root.spent-column-width; }
                                    Text { visible: root.show-remaining; width: root.remaining-column-width; text: "残余"; font-weight: 700; font-size: 11px; vertical-alignment: center; horizontal-alignment: left; }
                                    ColumnDivider { visible: root.show-remaining; column-width <=> root.remaining-column-width; }
                                    for column in root.custom-columns : HorizontalLayout { spacing: 0px; Text { width: root.custom-column-width; text: column.name; font-weight: 700; font-size: 11px; vertical-alignment: center; horizontal-alignment: left; overflow: elide; } ColumnDivider { column-width <=> root.custom-column-width; } }
                                }
                            }
                            list := ListView {
                                min-width: 0px;
                                preferred-width: 0px;
                                viewport-width: root.table-content-width;
                                horizontal-scrollbar-policy: as-needed;
                                for issue in root.issues : Rectangle {
                                    height: 42px; width: root.table-content-width;
                                    background: issue.key == root.selected-key ? #e0e7ff : touch.has-hover ? #f8fafc : white;
                                    border-color: #eef2f7; border-width: 1px;
                                    HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 0px;
                                        Rectangle { width: root.issue-type-column-width; background: transparent; clip: true;
                                            Rectangle { x: issue.depth * 10px; y: 12px; width: 17px; height: 17px; visible: issue.has-children; border-color: #cbd5e1; border-width: 1px; border-radius: 3px;
                                                Text { text: issue.expanded ? "-" : "+"; horizontal-alignment: center; vertical-alignment: center; font-size: 11px; }
                                                TouchArea { clicked => { root.toggle-tree(issue.key); } }
                                            }
                                            Rectangle { x: issue.depth * 10px + (issue.has-children ? 21px : 0px); y: 9px; width: parent.width - self.x - 4px; height: 24px; background: #dbeafe; border-radius: 7px;
                                                Text { text: issue.issue-type; color: #1d4ed8; font-size: 9px; vertical-alignment: center; horizontal-alignment: left; overflow: elide; }
                                            }
                                        }
                                        Rectangle { width: 6px; background: transparent; }
                                        Text { width: root.key-column-width; text: issue.key; color: #1d4ed8; font-size: 11px; font-weight: 600; vertical-alignment: center; horizontal-alignment: left; }
                                        Rectangle { width: 6px; background: transparent; }
                                        Rectangle { width: root.summary-column-width; background: transparent; clip: true;
                                            Text { visible: !root.edit-mode; width: parent.width; text: issue.summary; color: #1e293b; font-size: 12px; vertical-alignment: center; horizontal-alignment: left; overflow: elide; }
                                            LineEdit { visible: root.edit-mode; width: parent.width; text: issue.summary; edited(value) => { root.edit-table-cell(issue.key, "summary", value); } }
                                        }
                                        Rectangle { width: 6px; background: transparent; }
                                        Rectangle { width: root.status-column-width; background: issue.status-done ? #dcfce7 : #e0e7ff; border-radius: 8px; Text { text: issue.status; color: issue.status-done ? #15803d : #475569; font-size: 10px; vertical-alignment: center; horizontal-alignment: left; overflow: elide; } }
                                        Rectangle { width: 6px; background: transparent; }
                                        Text { visible: root.show-assignee; width: root.assignee-column-width; text: issue.assignee; font-size: 11px; vertical-alignment: center; horizontal-alignment: left; overflow: elide; }
                                        Rectangle { visible: root.show-assignee; width: 6px; background: transparent; }
                                        Rectangle { visible: root.show-due; width: root.due-column-width; background: transparent;
                                            Text { visible: !root.edit-mode; text: issue.due; font-size: 11px; vertical-alignment: center; }
                                            LineEdit { visible: root.edit-mode; text: issue.due; edited(value) => { root.edit-table-cell(issue.key, "duedate", value); } }
                                        }
                                        Rectangle { visible: root.show-due; width: 6px; background: transparent; }
                                        Rectangle { visible: root.show-estimate; width: root.estimate-column-width; background: transparent;
                                            Text { visible: !root.edit-mode; text: issue.estimate; font-size: 11px; vertical-alignment: center; }
                                            LineEdit { visible: root.edit-mode; text: issue.estimate; edited(value) => { root.edit-table-cell(issue.key, "estimate", value); } }
                                        }
                                        Rectangle { visible: root.show-estimate; width: 6px; background: transparent; }
                                        Text { visible: root.show-spent; width: root.spent-column-width; text: issue.spent; font-size: 11px; vertical-alignment: center; horizontal-alignment: left; }
                                        Rectangle { visible: root.show-spent; width: 6px; background: transparent; }
                                        Rectangle { visible: root.show-remaining; width: root.remaining-column-width; background: transparent;
                                            Text { visible: !root.edit-mode; text: issue.remaining; font-size: 11px; vertical-alignment: center; }
                                            LineEdit { visible: root.edit-mode; text: issue.remaining; edited(value) => { root.edit-table-cell(issue.key, "remaining", value); } }
                                        }
                                        Rectangle { visible: root.show-remaining; width: 6px; background: transparent; }
                                        for cell in issue.custom-cells : HorizontalLayout { spacing: 0px; Rectangle { width: root.custom-column-width; background: transparent;
                                            Text { visible: !root.edit-mode || !cell.editable; text: cell.value; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                            LineEdit { visible: root.edit-mode && cell.editable && !cell.boolean && !cell.checkbox; text: cell.value; edited(value) => { root.edit-table-cell(issue.key, cell.field-id, value); } }
                                            boolean-editor := CheckBox { visible: root.edit-mode && cell.editable && cell.boolean; checked: cell.checked; toggled => { root.edit-table-cell(issue.key, cell.field-id, self.checked ? "true" : "false"); } }
                                            Button { visible: root.edit-mode && cell.editable && cell.checkbox; text: cell.value == "" ? "選択..." : cell.value; clicked => { root.open-checkbox-editor(issue.key, cell.field-id); } }
                                        } Rectangle { width: 6px; background: transparent; } }
                                    }
                                    touch := TouchArea { visible: !root.edit-mode; x: root.issue-type-column-width + 6px; width: parent.width - self.x; clicked => { root.select-issue(issue.key); } }
                                }
                            }
                        }
                    }
                }
            }

            PaneDivider { visible: root.show-right-pane; width: root.show-right-pane ? 7px : 0px; pane-size <=> root.right-pane-width; minimum: 260px; maximum: 560px; direction: -1; }

            Rectangle {
                visible: root.show-right-pane; width: root.show-right-pane ? root.right-pane-width : 0px; background: white;
                ScrollView {
                    VerticalLayout {
                        padding: 14px; spacing: 10px;
                        HorizontalLayout { height: 32px; spacing: 6px;
                            Text { text: root.selected-key; color: #2563eb; font-size: 13px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                            Button { text: "Jiraで開く"; clicked => { root.open-issue-in-jira(); } }
                        }
                        Text { text: root.selected-summary; color: #0f172a; font-size: 17px; font-weight: 700; wrap: word-wrap; horizontal-alignment: left; }
                        Text { text: root.selected-issue-type + " / " + root.selected-status + (root.selected-assignee == "" ? "" : " / " + root.selected-assignee); color: #64748b; font-size: 11px; wrap: word-wrap; horizontal-alignment: left; }
                        Text { text: root.selected-description == "" ? "本文なし" : root.selected-description; color: #334155; font-size: 12px; wrap: word-wrap; horizontal-alignment: left; }
                        Text { text: "課題内容の編集は、一覧の編集モードまたはJira画面で行ってください。"; color: #64748b; font-size: 10px; wrap: word-wrap; }
                        Rectangle { height: 1px; background: #e2e8f0; }
                        SectionTitle { text: "時間管理"; height: 24px; }
                        Text { text: "期限: " + (root.selected-due == "" ? "未設定" : root.selected-due); font-size: 11px; color: #475569; }
                        Text { text: "初期見積: " + root.selected-estimate + " / 消費: " + root.selected-spent + " / 残余: " + root.selected-remaining; font-size: 11px; color: #475569; wrap: word-wrap; }
                        Rectangle { height: 1px; background: #e2e8f0; }
                        SectionTitle { text: "作業時間を記録"; height: 24px; }
                        Text { text: "作業開始日時"; font-size: 11px; color: #64748b; }
                        HorizontalLayout { height: 32px; spacing: 6px;
                            Button { horizontal-stretch: 1; text: root.worklog-date; clicked => { root.show-calendar = !root.show-calendar; } }
                            LineEdit { width: 76px; text <=> root.worklog-time; placeholder-text: "09:00"; }
                        }
                        Rectangle {
                            visible: root.show-calendar;
                            height: 226px; background: #f8fafc; border-color: #cbd5e1; border-width: 1px; border-radius: 6px;
                            VerticalLayout { padding: 8px; spacing: 5px;
                                HorizontalLayout { height: 28px; Button { text: "<"; clicked => { root.calendar-previous(); } } Text { text: root.calendar-label; horizontal-stretch: 1; horizontal-alignment: center; vertical-alignment: center; font-weight: 700; } Button { text: ">"; clicked => { root.calendar-next(); } } }
                                Text { text: " 日　月　火　水　木　金　土"; horizontal-alignment: center; color: #64748b; font-size: 11px; }
                                GridLayout {
                                    height: 168px;
                                    spacing: 2px;
                                    for day in root.calendar-days : Button {
                                        row: day.row; col: day.column;
                                        text: day.label;
                                        enabled: day.current-month;
                                        clicked => { root.choose-date(day.date); }
                                    }
                                }
                            }
                        }
                        Text { text: "作業時間（分）"; font-size: 11px; color: #64748b; }
                        SpinBox { value <=> root.worklog-minutes; minimum: 1; maximum: 1440; }
                        CheckBox { text: "消費時間分だけ残余時間を自動で減らす"; checked <=> root.worklog-auto-adjust; }
                        Text { text: "登録後の残余時間"; font-size: 11px; color: #64748b; }
                        LineEdit { enabled: !root.worklog-auto-adjust; text <=> root.worklog-remaining; }
                        Button { enabled: !root.action-busy && root.selected-key != ""; text: root.action-busy ? "登録中..." : "作業時間を記録"; primary: true; clicked => { root.log-work(root.selected-key, root.worklog-date, root.worklog-time, root.worklog-minutes, root.worklog-remaining, root.worklog-auto-adjust); } }
                        Text { visible: root.action-status != ""; text: root.action-status; wrap: word-wrap; font-size: 11px; color: #475569; }
                        Text { text: "記録済み: " + root.selected-spent + " / 残余: " + root.selected-remaining; font-size: 11px; color: #64748b; }
                        Rectangle { height: 1px; background: #e2e8f0; }
                        SectionTitle { text: "最新コメント"; height: 24px; }
                        Text { text: root.selected-comments; wrap: word-wrap; font-size: 12px; color: #475569; }
                    }
                }
            }
        }
    }
    if root.confirm-discard : Rectangle {
        background: #00000066;
        Rectangle { width: 420px; height: 170px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; background: white; border-radius: 10px;
            VerticalLayout { padding: 20px; spacing: 12px;
                Text { text: "未保存の変更を破棄しますか？"; font-size: 16px; font-weight: 700; color: #0f172a; }
                Text { text: "一覧で編集した内容は保存されません。"; color: #475569; }
                HorizontalLayout { alignment: end; spacing: 8px;
                    Button { text: "戻る"; clicked => { root.confirm-discard = false; } }
                    Button { text: "変更を破棄"; clicked => { root.confirm-discard = false; root.discard-table-edit(); } }
                }
            }
        }
    }
    if root.checkbox-editor-open : Rectangle {
        background: #00000066;
        Rectangle { width: 440px; height: min(460px, 150px + root.checkbox-options.length * 38px); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; background: white; border-radius: 10px;
            VerticalLayout { padding: 20px; spacing: 12px;
                Text { text: root.checkbox-editor-title; font-size: 16px; font-weight: 700; color: #0f172a; }
                ScrollView { vertical-stretch: 1;
                    VerticalLayout { spacing: 6px;
                        for option[index] in root.checkbox-options : CheckBox {
                            text: option.label;
                            checked: option.checked;
                            toggled => { root.toggle-checkbox-option(index, self.checked); }
                        }
                    }
                }
                HorizontalLayout { alignment: end; spacing: 8px;
                    Button { text: "キャンセル"; clicked => { root.checkbox-editor-open = false; } }
                    Button { text: "反映"; primary: true; clicked => { root.apply-checkbox-options(); } }
                }
            }
        }
    }
}
