import { Button, CheckBox, LineEdit, ListView, ScrollView, SpinBox, TextEdit } from "std-widgets.slint";

export struct IssueRow {
    key: string,
    summary: string,
    status: string,
    assignee: string,
    due: string,
    estimate: string,
    spent: string,
    parent: string,
}

export struct TreeNode {
    key: string,
    label: string,
    depth: int,
}

export struct CalendarDay {
    label: string,
    date: string,
    row: int,
    column: int,
    current-month: bool,
}

export struct BurndownPoint {
    label: string,
    remaining: string,
    height: int,
}

component SectionTitle inherits Text {
    font-size: 13px;
    font-weight: 700;
    color: #24324a;
    vertical-alignment: center;
}

component TreeButton inherits Rectangle {
    in property <string> label;
    in property <string> key;
    in property <int> depth: 0;
    callback chosen(string);
    height: 34px;
    border-radius: 5px;
    background: touch.has-hover ? #e9efff : transparent;
    Text { x: 9px + root.depth * 15px; width: parent.width - self.x - 6px; text: root.label; color: #334155; font-size: 12px; vertical-alignment: center; overflow: elide; }
    touch := TouchArea { clicked => { root.chosen(root.key); } }
}

export component AppWindow inherits Window {
    title: "Jira Lens";
    width: 1280px;
    height: 780px;
    background: #f6f8fb;

    in property <[IssueRow]> issues;
    in property <[TreeNode]> tree-nodes;
    in property <[CalendarDay]> calendar-days;
    in property <[BurndownPoint]> burndown-points;
    in-out property <string> selected-key: "APP-102";
    in-out property <string> selected-summary: "課題一覧テーブル";
    in-out property <string> selected-description: "Excelのように見通しのよい一覧を作る";
    in-out property <string> selected-comments: "列の表示切替を追加";
    in-out property <string> selected-due: "2026-08-28";
    in-out property <string> selected-estimate: "12h";
    in-out property <string> selected-spent: "4h";
    in-out property <string> active-parent: "すべての課題";
    in-out property <int> result-count: 0;
    in-out property <bool> show-assignee: true;
    in-out property <bool> show-due: true;
    in-out property <bool> show-estimate: true;
    in-out property <bool> show-spent: true;
    in-out property <bool> show-calendar: false;
    in-out property <string> calendar-label: "";
    in-out property <string> calendar-target: "due";
    in-out property <string> worklog-date: "";
    in-out property <string> worklog-time: "09:00";
    in-out property <int> worklog-minutes: 60;
    in-out property <string> action-status: "";
    in-out property <bool> action-busy: false;
    in-out property <string> burndown-title: "バーンダウン";
    in-out property <string> burndown-summary: "履歴データなし";
    in-out property <bool> connection-busy: false;
    in-out property <bool> has-synced-data: false;
    in-out property <string> connection-status: "未接続";
    callback select-issue(string);
    callback search(string);
    callback filter-parent(string);
    callback connect-oauth();
    callback save-issue(string, string, string, string, string);
    callback columns-changed(bool, bool, bool, bool);
    callback log-work(string, string, string, int);
    callback calendar-previous();
    callback calendar-next();
    callback choose-date(string);

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 52px;
            background: #172554;
            HorizontalLayout {
                padding-left: 18px; padding-right: 18px; spacing: 14px;
                Text { text: "Jira Lens"; color: white; font-size: 19px; font-weight: 700; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Text { text: root.connection-status; color: #c7d2fe; font-size: 12px; vertical-alignment: center; }
                Button { enabled: !root.connection-busy; text: root.connection-busy ? "同期中…" : root.has-synced-data ? "再同期" : "Jiraに接続"; clicked => { root.connect-oauth(); } }
            }
        }

        HorizontalLayout {
            spacing: 1px;
            Rectangle {
                width: 238px; background: #ffffff;
                VerticalLayout {
                    padding: 12px; spacing: 7px;
                    SectionTitle { text: "課題ツリー"; height: 28px; }
                    LineEdit { placeholder-text: "タイトル・本文・コメントを検索"; accepted => { root.search(self.text); } }
                    tree := ListView {
                        for node in root.tree-nodes : TreeButton {
                            width: tree.viewport-width;
                            label: node.label;
                            key: node.key;
                            depth: node.depth;
                            chosen(key) => { root.filter-parent(key); }
                        }
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    Text { text: "同期データは端末内にキャッシュ"; color: #94a3b8; font-size: 10px; }
                }
            }

            Rectangle {
                horizontal-stretch: 1; background: #f8fafc;
                VerticalLayout {
                    padding: 14px; spacing: 10px;
                    HorizontalLayout {
                        height: 34px; spacing: 8px;
                        SectionTitle { text: root.active-parent + "  ·  " + root.result-count + "件"; horizontal-stretch: 1; }
                        table-search := LineEdit { width: 260px; placeholder-text: "一覧を検索"; accepted => { root.search(self.text); } }
                        Button { text: "検索"; clicked => { root.search(table-search.text); } }
                    }
                    Rectangle {
                        height: 40px; background: #eef2ff; border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; spacing: 12px;
                            Text { text: "表示列"; font-size: 11px; vertical-alignment: center; color: #475569; }
                            CheckBox { text: "担当者"; checked <=> root.show-assignee; toggled => { root.columns-changed(root.show-assignee, root.show-due, root.show-estimate, root.show-spent); } }
                            CheckBox { text: "期限"; checked <=> root.show-due; toggled => { root.columns-changed(root.show-assignee, root.show-due, root.show-estimate, root.show-spent); } }
                            CheckBox { text: "見積"; checked <=> root.show-estimate; toggled => { root.columns-changed(root.show-assignee, root.show-due, root.show-estimate, root.show-spent); } }
                            CheckBox { text: "消費"; checked <=> root.show-spent; toggled => { root.columns-changed(root.show-assignee, root.show-due, root.show-estimate, root.show-spent); } }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                    }
                    Rectangle {
                        background: white; border-color: #e2e8f0; border-width: 1px; border-radius: 7px;
                        VerticalLayout {
                            spacing: 0px;
                            Rectangle {
                                height: 36px; background: #f1f5f9;
                                HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 8px;
                                    Text { width: 76px; text: "キー"; font-weight: 700; font-size: 11px; vertical-alignment: center; }
                                    Text { horizontal-stretch: 1; text: "タイトル"; font-weight: 700; font-size: 11px; vertical-alignment: center; }
                                    Text { width: 70px; text: "状態"; font-weight: 700; font-size: 11px; vertical-alignment: center; }
                                    Text { visible: root.show-assignee; width: 72px; text: "担当者"; font-weight: 700; font-size: 11px; vertical-alignment: center; }
                                    Text { visible: root.show-due; width: 88px; text: "期限"; font-weight: 700; font-size: 11px; vertical-alignment: center; }
                                    Text { visible: root.show-estimate; width: 54px; text: "見積"; font-weight: 700; font-size: 11px; vertical-alignment: center; }
                                    Text { visible: root.show-spent; width: 54px; text: "消費"; font-weight: 700; font-size: 11px; vertical-alignment: center; }
                                }
                            }
                            list := ListView {
                                for issue in root.issues : Rectangle {
                                    height: 42px; width: list.viewport-width;
                                    background: issue.key == root.selected-key ? #e0e7ff : touch.has-hover ? #f8fafc : white;
                                    border-color: #eef2f7; border-width: 1px;
                                    HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 8px;
                                        Text { width: 76px; text: issue.key; color: #1d4ed8; font-size: 11px; vertical-alignment: center; }
                                        Text { horizontal-stretch: 1; text: issue.summary; color: #1e293b; font-size: 12px; vertical-alignment: center; overflow: elide; }
                                        Text { width: 70px; text: issue.status; color: issue.status == "完了" ? #15803d : #475569; font-size: 11px; vertical-alignment: center; }
                                        Text { visible: root.show-assignee; width: 72px; text: issue.assignee; font-size: 11px; vertical-alignment: center; }
                                        Text { visible: root.show-due; width: 88px; text: issue.due; font-size: 11px; vertical-alignment: center; }
                                        Text { visible: root.show-estimate; width: 54px; text: issue.estimate; font-size: 11px; vertical-alignment: center; }
                                        Text { visible: root.show-spent; width: 54px; text: issue.spent; font-size: 11px; vertical-alignment: center; }
                                    }
                                    touch := TouchArea { clicked => { root.select-issue(issue.key); } }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                width: 300px; background: white;
                ScrollView {
                    VerticalLayout {
                        padding: 14px; spacing: 10px;
                        Text { text: root.selected-key; color: #2563eb; font-size: 13px; font-weight: 700; }
                        LineEdit { text <=> root.selected-summary; }
                        TextEdit { height: 92px; text <=> root.selected-description; wrap: word-wrap; }
                        Rectangle { height: 1px; background: #e2e8f0; }
                        SectionTitle { text: "時間管理"; height: 24px; }
                        Text { text: "初期見積もり"; font-size: 11px; color: #64748b; }
                        LineEdit { text <=> root.selected-estimate; }
                        Text { text: "期限"; font-size: 11px; color: #64748b; }
                        HorizontalLayout { height: 32px; spacing: 6px;
                            Button { horizontal-stretch: 1; text: root.selected-due == "" ? "未設定" : root.selected-due; clicked => { root.calendar-target = "due"; root.show-calendar = !root.show-calendar; } }
                            Button { width: 70px; text: "クリア"; clicked => { root.selected-due = ""; } }
                        }
                        Rectangle {
                            visible: root.show-calendar;
                            height: 226px; background: #f8fafc; border-color: #cbd5e1; border-width: 1px; border-radius: 6px;
                            VerticalLayout { padding: 8px; spacing: 5px;
                                HorizontalLayout { height: 28px; Button { text: "‹"; clicked => { root.calendar-previous(); } } Text { text: root.calendar-label; horizontal-stretch: 1; horizontal-alignment: center; vertical-alignment: center; font-weight: 700; } Button { text: "›"; clicked => { root.calendar-next(); } } }
                                Text { text: " 日　月　火　水　木　金　土"; horizontal-alignment: center; color: #64748b; font-size: 11px; }
                                GridLayout {
                                    height: 168px;
                                    spacing: 2px;
                                    for day in root.calendar-days : Button {
                                        row: day.row; col: day.column;
                                        text: day.label;
                                        enabled: day.current-month;
                                        clicked => { root.choose-date(day.date); }
                                    }
                                }
                            }
                        }
                        Button { enabled: !root.action-busy && root.selected-key != ""; text: root.action-busy ? "更新中…" : "課題を保存"; primary: true; clicked => { root.save-issue(root.selected-key, root.selected-summary, root.selected-description, root.selected-due, root.selected-estimate); } }
                        Rectangle { height: 1px; background: #e2e8f0; }
                        SectionTitle { text: "作業時間を記録"; height: 24px; }
                        Text { text: "作業開始日時"; font-size: 11px; color: #64748b; }
                        HorizontalLayout { height: 32px; spacing: 6px;
                            Button { horizontal-stretch: 1; text: root.worklog-date; clicked => { root.calendar-target = "worklog"; root.show-calendar = true; } }
                            LineEdit { width: 76px; text <=> root.worklog-time; placeholder-text: "09:00"; }
                        }
                        Text { text: "作業時間（分）"; font-size: 11px; color: #64748b; }
                        SpinBox { value <=> root.worklog-minutes; minimum: 1; maximum: 1440; }
                        Button { enabled: !root.action-busy && root.selected-key != ""; text: root.action-busy ? "登録中…" : "作業時間を記録"; primary: true; clicked => { root.log-work(root.selected-key, root.worklog-date, root.worklog-time, root.worklog-minutes); } }
                        Text { visible: root.action-status != ""; text: root.action-status; wrap: word-wrap; font-size: 11px; color: #475569; }
                        Text { text: "記録済み: " + root.selected-spent; font-size: 11px; color: #64748b; }
                        Rectangle { height: 1px; background: #e2e8f0; }
                        SectionTitle { text: root.burndown-title; height: 24px; }
                        Text { text: root.burndown-summary; font-size: 12px; color: #475569; }
                        Rectangle {
                            height: 132px; background: #f8fafc; border-radius: 6px;
                            HorizontalLayout { padding: 12px; spacing: 10px; alignment: end;
                                for point in root.burndown-points : VerticalLayout {
                                    alignment: end; spacing: 3px;
                                    Text { text: point.remaining; font-size: 8px; color: #475569; horizontal-alignment: center; }
                                    Rectangle { width: 24px; height: point.height * 1px; background: #6366f1; border-radius: 3px; }
                                    Text { text: point.label; font-size: 8px; color: #64748b; horizontal-alignment: center; }
                                }
                            }
                        }
                        SectionTitle { text: "最新コメント"; height: 24px; }
                        Text { text: root.selected-comments; wrap: word-wrap; font-size: 12px; color: #475569; }
                    }
                }
            }
        }
    }
}
